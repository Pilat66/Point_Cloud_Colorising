<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Scan colourisation: colours each instantaneous lidar sweep from the two
       forward cameras. Needs no map and no SLAM.

       Start this, then play a bag (or run live sensors) in another terminal.
       See the README for the exact rosbag play command; it is not repeated here
       because XML comments cannot contain a double hyphen.

       Output: /colorised_points, in the os_sensor frame.

       Args:
         config_path  alternative config.yaml, e.g. a scan specific one with a
                      lower min_camera_dist, which costs far more coverage on
                      single sweeps than it does on a map
         rviz         set false to run headless -->

  <arg name="config_path" default="$(find point_cloud_projection)/configs/config.yaml"/>
  <arg name="rviz"        default="true"/>
  <!-- none | imu | odom. Empty means use whatever config.yaml says. -->
  <arg name="compensation_mode" default=""/>

  <node pkg="point_cloud_projection"
        type="ColoriseScan"
        name="colorise_scan_node"
        output="screen">
    <param name="config_path"       value="$(arg config_path)"/>
    <param name="compensation_mode" value="$(arg compensation_mode)"/>
  </node>

  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find point_cloud_projection)/configs/vis.rviz"/>
</launch>
